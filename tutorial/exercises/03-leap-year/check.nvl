; The tests of exercise 03-leap-year.
(include "harness.nvl")
(include "answer.nvl")

(report! (list (check (leap-year? 2024) #true)
               (check (leap-year? 2023) #false)
               (check (leap-year? 1900) #false)
               (check (leap-year? 2000) #true)
               (check (days-in-year 2024) 366)
               (check (days-in-year 2023) 365)))
