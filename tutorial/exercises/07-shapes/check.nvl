; The tests of exercise 07-shapes.
(include "harness.nvl")
(include "answer.nvl")

(report! (list (check (area '(:circle 1.0)) 3.14159)
               (check (area '(:rectangle 2.0 3.0)) 6.0)
               (check (area '(:square 3.0)) 9.0)
               (check (perimeter '(:circle 1.0)) 6.28318)
               (check (perimeter '(:rectangle 2.0 3.0)) 10.0)
               (check (perimeter '(:square 3.0)) 12.0)
               (check (describe '(:circle 2.0)) "a circle")
               (check (describe '(:rectangle 4.0 1.0)) "a wide rectangle")
               (check (describe '(:rectangle 1.0 4.0)) "a tall rectangle")
               (check (describe '(:rectangle 2.0 2.0)) "a square")
               (check (describe '(:square 2.0)) "a square")))
