; The tests of exercise 05-own-map.
(include "harness.nvl")
(include "answer.nvl")

(define square (lambda (n) (* n n)))
(define odd? (lambda (n) (= (remainder n 2) 1)))

(report! (list (check (my-map square '(1 2 3)) '(1 4 9))
               (check (my-map square '()) '())
               (check (my-filter odd? '(1 2 3 4 5)) '(1 3 5))
               (check (my-filter odd? '(2 4)) '())
               (check (count (my-map square (range 0 1000000))) 1000000)
               (check (group-adjacent '(1 1 2 3 3 3 1)) '((1 1) (2) (3 3 3) (1)))
               (check (group-adjacent '(:a)) '((:a)))
               (check (group-adjacent '()) '())))
