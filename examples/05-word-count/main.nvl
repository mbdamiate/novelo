; Word frequency.
;
; Reads text from standard input and prints the five most frequent words,
; one per line, as "count word". Words are separated by spaces; they are
; compared exactly, so "The" and "the" are different words, and punctuation
; stays attached to the word it touches.
;
;   build/novelo examples/05-word-count/main.nvl < examples/05-word-count/input.txt

(import io)        ; display!, read-line!
(import list)      ; fold, filter, sort, take, ...
(import text t)    ; t/split
(import map)       ; entries

(define how-many 5)

; The words of one line: split on single spaces, then drop the empty strings
; that runs of spaces leave between them.
(define words
  (lambda (line)
    (filter (lambda (word) (not (empty? word)))
            (t/split " " line))))

; Counting goes into a Map from word to count. Maps are persistent, so
; adding a word returns a new map and leaves `counts` as it was.
(define count-word
  (lambda (counts word)
    (associate counts word (+ 1 (get counts word 0)))))

; Reads every line until the end of the input (read-line! returns #void) and
; returns the counts. The recursive call is in tail position, so the loop runs
; in constant memory however long the input is.
(define read-counts!
  (lambda (counts)
    (let ((line (read-line!)))
      (if (void? line) counts
          otherwise (read-counts! (fold count-word counts (words line)))))))

; `entries` turns the map into a list of (word count) lists. `match` takes an
; entry apart: the pattern (word count) matches a list of two elements and
; names them. `_` matches a part without naming it.
(define more-frequent?
  (lambda (a b)
    (match (list a b)
      ((_ count-a) (_ count-b)) (> count-a count-b))))

; Most frequent first. The library's merge sort is stable, so words with the
; same count keep the order in which they first appeared.
(define ranked
  (lambda (counts)
    (sort more-frequent? (entries counts))))

; Inside the result, `count` is the entry's count: a name bound by a
; pattern hides a global of the same name, here the primitive `count`.
(define show!
  (lambda (entry)
    (match entry
      (word count) (display! (concatenate (to-string count) " " word "\n")))))

; Prints each entry; `fold` is used only to walk the list in order.
(define show-all!
  (lambda (entries)
    (fold (lambda (ignored entry) (show! entry)) #void entries)))

(show-all! (take how-many (ranked (read-counts! {}))))
