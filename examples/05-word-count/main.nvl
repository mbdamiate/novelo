; Word frequency.
;
; Reads text from standard input and prints the six most frequent words,
; one per line, each word followed by its count, the counts lined up in
; one column. A word is a run of letters, so punctuation
; separates words, and case does not matter: "The" and "the" are one word.
; Words with the same count are listed alphabetically.
;
;   build/novelo examples/05-word-count/main.nvl < examples/05-word-count/input.txt

(import io)        ; display!, read-line!
(import list)      ; fold, filter, map, sort, take, ...
(import text t)    ; t/split, t/join, t/lowercase, t/letter?, t/precedes?, ...
(import map)       ; entries
(import number)    ; max

(define how-many 6)

; Text is made of code points, the numbers of its characters:
; `string-to-code-points` gives them as a list of Integers, and
; `code-points-to-string` turns such a list back into text. Converting a
; line once and working on the list is how a program looks at every
; character. Here each character that is not a letter becomes a space.
(define space 32)

(define letter-or-space
  (lambda (code-point)
    (if (t/letter? (code-points-to-string (list code-point))) code-point
        otherwise space)))

; The words of one line: punctuation turned into spaces, everything in
; lowercase, split on single spaces, then the empty strings that runs of
; spaces leave between them dropped. "Ball," and "ball." both become "ball";
; a word with an apostrophe, such as "don't", becomes "don" and "t".
(define words
  (lambda (line)
    (let ((letters (code-points-to-string (map letter-or-space (string-to-code-points line)))))
      (filter (lambda (word) (not (empty? word)))
              (t/split " " (t/lowercase letters))))))

; Counting goes into a Map from word to count. Maps are persistent, so
; adding a word returns a new map and leaves `counts` as it was.
(define count-word
  (lambda (counts word)
    (associate counts word (+ 1 (get counts word 0)))))

; Reads every line until the end of the input (read-line! returns #void) and
; returns the counts. The recursive call is in tail position, so the loop runs
; in constant memory however long the input is.
(define read-counts!
  (lambda (counts)
    (let ((line (read-line!)))
      (if (void? line) counts
          otherwise (read-counts! (fold count-word counts (words line)))))))

; `entries` turns the map into a list of (word count) lists. A `let`
; binding may be a pattern instead of a name, which takes a value apart:
; (word-a count-a) matches a list of two elements and names both. A value
; of another shape would be the error :no-match.
;
; The higher count comes first; on equal counts, `t/precedes?` puts the
; words in order. It compares code points, which for lowercase ASCII letters
; is alphabetical order.
(define comes-before?
  (lambda (a b)
    (let (((word-a count-a) a)
          ((word-b count-b) b))
      (if (> count-a count-b) #true
          (< count-a count-b) #false
          otherwise (t/precedes? word-a word-b)))))

(define ranked
  (lambda (counts)
    (sort comes-before? (entries counts))))

; One line of the report: the word, filled with spaces up to `width`
; characters by `t/pad-right`, then the count. `t/format` puts each value
; into the template at a `{}`. Inside the `let`, `count` is the entry's
; count: a name bound by a pattern hides a global of the same name, here the
; primitive `count`.
(define report-line
  (lambda (width entry)
    (let (((word count) entry))
      (t/format "{} {}\n" (t/pad-right width " " word) count))))

; The column of counts starts after the longest word shown. `max` takes its
; arguments one by one, so the list of lengths goes through `apply`; it needs
; at least one, so an empty input gives an empty report.
(define report
  (lambda (top)
    (if (empty? top) ""
        otherwise
        (let ((width (apply max (map (lambda (entry) (count (first entry))) top))))
          (t/join "" (map (lambda (entry) (report-line width entry)) top))))))

; The work above is pure: it only computes values. The program builds the
; whole report as one String and prints it with a single display!, so the
; effect stays at the edge of the program.
(display! (report (take how-many (ranked (read-counts! {})))))
