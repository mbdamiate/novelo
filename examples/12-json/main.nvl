; Orders in JSON.
;
; Reads one order per line, written in JSON (JSON Lines), checks its shape,
; prints a line for each, then writes a report as JSON: how many lines were
; read, which were rejected, and the total spent by each customer. A line
; that is not JSON, or not an order, is reported with the reason and left
; out; it does not stop the program.
;
;   build/novelo examples/12-json/main.nvl < examples/12-json/input.txt
;
; Reading and writing JSON is the library `json` (stdlib 0.12.0): this file
; is only about orders. A line that is not JSON, or an order of the wrong
; shape, is not an error here: `read-json` and the functions that check an
; order return a result, (:ok value) or (:error …), and the program looks at
; it with `match`.
;
; The library began as a file of this example, json.nvl, written with what
; the earlier examples used: lists and `match` (04, 05), modules (08), the
; text library (10, 11). Writing it showed where the language was awkward:
; naming the parts of a result became the patterns of `let` (core 0.11.0);
; splitting a text into characters and reading and writing hexadecimal
; became `characters`, `digits-to-integer` and `integer-to-digits` (stdlib
; 0.8.0); steps that each may fail became `chain` (core 0.14.0) and the
; library `result` (stdlib 0.10.0). make bench then found it measured each
; number by counting the rest of the text, which made it quadratic; the
; library gathers the number's characters as it reads them.

(import io)
(import list)      ; every?, fold, map, reverse
(import text t)    ; t/format, t/join
(import number)    ; round
(import map)       ; map-values
(import result)    ; ok, failure, then, map-results
(import json)      ; read-json, write-json

; ---- orders -------------------------------------------------------------------

; An order is an object with a "customer" string and "items", a list of
; objects with a "price" (any number) and a "quantity" (a whole number).
; Other fields are allowed and ignored. A map pattern matches a Map that
; has the keys it names, whatever else it has.
;
; Checking an order gives a result, as reading JSON does: (:ok value), or
; (:error message values) for an order of the wrong shape, which is an
; answer the program expects, not an error.
(define as-float
  (lambda (number)
    (if (integer? number) (integer-to-float number)
        (float? number) number
        otherwise #void)))

(define item-total
  (lambda (item)
    (match item
      {"price" price "quantity" quantity}
      (if (and (not (void? (as-float price))) (integer? quantity) (>= quantity 0))
          (ok (* (as-float price) (integer-to-float quantity)))
          otherwise (failure "an item needs a price and a whole quantity" (list (write-json item))))
      otherwise (failure "an item needs a price and a quantity" (list (write-json item))))))

; The sum of the items, or the first item that fails: `map-results` gives
; the amounts of all the items, or stops at the first failure.
(define items-total
  (lambda (items)
    (chain then ((amounts (map-results item-total items)))
      (ok (fold + 0.0 amounts)))))

(define order-total
  (lambda (order)
    (match order
      {"customer" customer "items" items}
      (if (not (string? customer)) (failure "the customer must be a string" ())
          (not (list? items)) (failure "the items must be a list" ())
          otherwise (chain then ((total (items-total items)))
                      (ok (list customer (count items) total))))
      otherwise (failure "an order needs a customer and items" ()))))

; Money is shown with two decimals; the report keeps the total rounded to
; cents as a Float.
(define cents (lambda (amount) (/ (integer-to-float (round (* amount 100.0))) 100.0)))

; ---- the report -----------------------------------------------------------------

; The state carried from line to line: the totals per customer, the
; numbers of the lines rejected, and the lines of text to print, newest
; first. Nothing is printed while the orders are read; the text is printed
; once, at the end, with the report.
(define say
  (lambda (state text)
    (associate state :output (prepend text (get state :output)))))

(define accept
  (lambda (state number customer item-count total)
    (let ((totals (get state :totals)))
      (say (associate state :totals (associate totals customer (+ total (get totals customer 0.0))))
           (t/format "{}: {}, {} {}, {}\n" number (write-json customer) item-count
                     (if (= item-count 1) "item" otherwise "items") (float-to-fixed total 2))))))

(define reject
  (lambda (state number reason)
    (say (associate state :rejected (prepend number (get state :rejected)))
         (t/format "{}: rejected, {}\n" number reason))))

; A line that is not JSON gives the column of the problem (each text read
; is one line, so its line is always 1); an order of the wrong shape gives
; its message and values.
(define record
  (lambda (state number line)
    (match (read-json line)
      (:error message _ column) (reject state number (t/format "column {}: {}" column message))
      (:ok order)
      (match (order-total order)
        (:error message values) (reject state number (t/join " " (prepend message (map to-string values))))
        (:ok (customer item-count total)) (accept state number customer item-count total)))))

; A line of spaces alone holds no order and is skipped.
(define blank?
  (lambda (line)
    (every? (lambda (character) (equal? character " ")) (t/characters line))))

(define read-orders
  (lambda (state number)
    (let ((line (read-line!)))
      (if (void? line) (associate state :lines (- number 1))
          (blank? line) (read-orders state (+ number 1))
          otherwise (read-orders (record state number line) (+ number 1))))))

(define state (read-orders {:totals {} :rejected () :output ()} 1))

(display! (concatenate (t/join "" (reverse (get state :output)))
                       "\n"
                       (write-json {"lines" (get state :lines)
                                    "rejected" (reverse (get state :rejected))
                                    "totals" (map-values cents (get state :totals))})
                       "\n"))
