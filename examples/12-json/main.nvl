; Orders in JSON.
;
; Reads one order per line, written in JSON (JSON Lines), checks its shape,
; prints a line for each, then writes a report as JSON: how many lines were
; read, which were rejected, and the total spent by each customer. A line
; that is not JSON, or not an order, is reported with the reason and left
; out; it does not stop the program.
;
;   build/novelo examples/12-json/main.nvl < examples/12-json/input.txt
;
; Reading and writing JSON is in json.nvl, next to this file, written with
; what the earlier examples used: lists and `match` (04, 05), errors (07),
; modules (08), the text library (10, 11). This file is only about orders.
;
; Writing it showed where the language was awkward; the notes marked
; "friction" in json.nvl say where. Naming the parts of a result became the
; patterns of `let` (core 0.11.0); splitting a text into characters and
; reading and writing hexadecimal became `characters`, `digits-to-integer`
; and `integer-to-digits` (stdlib 0.8.0).

(import io)
(import list)      ; fold, map, reverse
(import text t)    ; t/format, t/join
(import number)    ; round
(import map)       ; map-values

; Every name json.nvl defines is bound here as json/<name>.
(include "json.nvl" json)

; ---- orders -------------------------------------------------------------------

; An order is an object with a "customer" string and "items", a list of
; objects with a "price" (any number) and a "quantity" (a whole number).
; Other fields are allowed and ignored. A map pattern matches a Map that
; has the keys it names, whatever else it has.
(define as-float
  (lambda (number)
    (if (integer? number) (integer-to-float number)
        (float? number) number
        otherwise #void)))

(define item-total
  (lambda (item)
    (match item
      {"price" price "quantity" quantity}
      (if (and (not (void? (as-float price))) (integer? quantity) (>= quantity 0))
          (* (as-float price) (integer-to-float quantity))
          otherwise (error "an item needs a price and a whole quantity" (json/write item)))
      otherwise (error "an item needs a price and a quantity" (json/write item)))))

(define order-total
  (lambda (order)
    (match order
      {"customer" customer "items" items}
      (if (not (string? customer)) (error "the customer must be a string")
          (not (list? items)) (error "the items must be a list")
          otherwise (list customer (count items) (fold + 0.0 (map item-total items))))
      otherwise (error "an order needs a customer and items"))))

; Money is shown with two decimals; the report keeps the total rounded to
; cents as a Float.
(define cents (lambda (amount) (/ (integer-to-float (round (* amount 100.0))) 100.0)))

; ---- the report -----------------------------------------------------------------

; The state carried from line to line: the totals per customer, the
; numbers of the lines rejected, and the lines of text to print, newest
; first. Nothing is printed while the orders are read; the text is printed
; once, at the end, with the report. A JSON error gives a column; any other
; error, from checking the order, gives its message and values.
(define reason
  (lambda (problem)
    (match problem
      {:kind :json :values (column)}
      (t/format "column {}: {}" column (get problem :message))
      otherwise (t/join " " (prepend (get problem :message) (map to-string (get problem :values ())))))))

(define say
  (lambda (state text)
    (associate state :output (prepend text (get state :output)))))

(define record
  (lambda (state number line)
    (catch (lambda ()
             (let (((customer item-count total) (order-total (json/read line)))
                   (totals (get state :totals)))
               (say (associate state :totals (associate totals customer (+ total (get totals customer 0.0))))
                    (t/format "{}: {}, {} {}, {}\n" number (json/string customer) item-count
                              (if (= item-count 1) "item" otherwise "items") (float-to-fixed total 2)))))
           (lambda (problem)
             (say (associate state :rejected (prepend number (get state :rejected)))
                  (t/format "{}: rejected, {}\n" number (reason problem)))))))

(define read-orders
  (lambda (state number)
    (let ((line (read-line!)))
      (if (void? line) (associate state :lines (- number 1))
          (json/blank? line) (read-orders state (+ number 1))
          otherwise (read-orders (record state number line) (+ number 1))))))

(define state (read-orders {:totals {} :rejected () :output ()} 1))

(display! (concatenate (t/join "" (reverse (get state :output)))
                       "\n"
                       (json/write {"lines" (get state :lines)
                                    "rejected" (reverse (get state :rejected))
                                    "totals" (map-values cents (get state :totals))})
                       "\n"))
