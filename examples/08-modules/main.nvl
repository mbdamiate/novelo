; Modules: a program split across files.
;
; `include` loads the forms of another file as if they were written here.
; With a prefix, the file's names are kept apart under that prefix, so two
; files can use the same names without clashing. The included files sit
; next to this one, in examples/08-modules/.
;
;   build/novelo examples/08-modules/main.nvl

(import io)

(define show!
  (lambda (label value)
    (display! label)
    (display! ": ")
    (write! value)
    (display! "\n")))

; This program has a `rectangle-area` of its own, which is not a function.
(define rectangle-area "the program's own")

; ---- with a prefix -----------------------------------------------------------

; The path is relative to this file. Every name shapes.nvl defines is bound
; here as shape/<name>; the file itself prints a line when it loads.
(include "shapes.nvl" shape)

(show! "square of side 3" (shape/square-area 3))
(show! "rectangle 2 by 5" (shape/rectangle-area 2 5))
(show! "square of 2 m, in cm²" (shape/square-area-in-centimeters 2))

; shapes.nvl included units.nvl with the prefix `units`, so from here its
; names carry both prefixes.
(show! "2 m in cm" (shape/units/centimeters 2))

; The program's own name is untouched by the file's definitions.
(show! "rectangle-area" rectangle-area)

; ---- loaded once -------------------------------------------------------------

; Including the same file again with the same prefix does nothing: no second
; "(loading shapes)" line. With another prefix it loads again, with its own
; copy of every name.
(include "shapes.nvl" shape)
(include "shapes.nvl" figure)
(show! "figure/square-area 4" (figure/square-area 4))

; ---- without a prefix ----------------------------------------------------------

; Without a prefix the file's definitions are plain global names, as if they
; had been written in this file.
(include "statistics.nvl")
(show! "mean" (mean '(4 8 15 16 23 42)))
(show! "total" (total '(4 8 15 16 23 42)))
