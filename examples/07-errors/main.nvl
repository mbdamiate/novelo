; Errors: raising, catching everything, catching by kind.
;
; Reads lines of two integers and prints the quotient of each. Bad lines do
; not stop the program: each error is caught, described and skipped.
;
;   build/novelo examples/07-errors/main.nvl < examples/07-errors/input.txt
;
; An error that nothing catches stops the program: it prints
; "file:line:column: error :kind: message values" on standard error and
; exits with 1. Everything below catches its errors, so it exits with 0.

(import io)
(import list)      ; filter, map
(import text t)    ; t/split, t/join

; ---- raising ---------------------------------------------------------------

; Every error is a map, its descriptor: {:kind … :message … :values (…)}.
; `error` builds one with :kind :error and stops the evaluation.
(define parse-integer
  (lambda (text)
    (let ((number (string-to-number text)))   ; #void when text is not an integer
      (if (void? number) (error "not an integer" text)
          otherwise number))))

(define fields
  (lambda (line)
    (filter (lambda (field) (not (empty? field)))
            (t/split " " line))))

; `match` checks that the line has exactly two fields and names them. Any
; other shape falls to `otherwise`, where `raise` stops the evaluation with
; a descriptor the program built itself, with its own :kind.
;
; Errors raised by primitives have kinds of their own: `quotient` by zero
; raises :division-by-zero, and `string-to-number` of a number too large for
; 64 bits raises :integer-overflow.
(define divide-line
  (lambda (line)
    (match (fields line)
      (numerator divisor) (quotient (parse-integer numerator) (parse-integer divisor))
      otherwise (raise {:kind :bad-line
                        :message "expected two integers"
                        :values (list line)}))))

; ---- catching ----------------------------------------------------------------

; (catch body handler) calls `body`, a function of no arguments. If it
; fails, the work it was doing is abandoned and `handler` receives the
; descriptor; whatever the handler returns becomes the value of `catch`.
;
; Errors raised while the program runs also carry :position, the line and
; column of the innermost form that failed. A map pattern names the parts of
; the descriptor it needs, even inside the nested :position map.
(define describe
  (lambda (problem)
    (match problem
      {:kind kind :message message :values values :position {:line line}}
      (concatenate "line " (to-string line) " of the program, " (to-string kind)
                   ": " message " " (to-string values)))))

; (try body pattern result …) catches only the errors whose descriptor
; matches one of its patterns, the patterns of `match`; the others go on,
; unchanged and with their position, to the next `catch` or `try` outward.
; Its body is an expression, not a function. Here a zero divisor is not a
; failure: the result is just "undefined". In a pattern, a literal such as
; :division-by-zero only matches an equal value. Every other error reaches
; the `catch` around it, which describes it.
(define answer
  (lambda (line)
    (try (to-string (divide-line line))
      {:kind :division-by-zero} "undefined")))

(define report-line
  (lambda (line)
    (concatenate line " → " (catch (lambda () (answer line)) describe) "\n")))

; `read-lines!` returns every line of the input, in order, as a List of
; Strings; it computes nothing from them. The work on the lines is pure and
; builds the text, and the program prints it once.

(display! (t/join "" (map report-line (read-lines!))))
