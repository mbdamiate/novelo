; A calculator in reverse Polish notation.
;
; Each input line is an expression with the operator after its operands:
; "3 4 +" is 3 + 4, and "5 1 2 + 4 * + 3 -" is 5 + (1 + 2) × 4 - 3. Numbers
; are pushed on a stack; each word takes its operands from the top of the
; stack and pushes its result. A line is valid when exactly one value is
; left. Errors are reported per line and do not stop the calculator.
;
;   build/novelo examples/10-calculator/main.nvl < examples/10-calculator/input.txt
;
; It brings together the earlier examples: reading input (01), tail-call
; loops (03), lists and fold (04), maps and match (05), errors (07).

(import io)
(import list)      ; fold, filter, map
(import text t)    ; t/split, t/join

; ---- the stack ------------------------------------------------------------------

; The stack is a plain list with its top first. It is never changed: pushing
; with `prepend` makes a new stack.
;
; `match` reads the top of the stack: the pattern (top &rest below) matches
; a stack with at least one value, naming the top and the stack under it,
; and (right left &rest below) one with at least two. A stack too short for
; the pattern falls to `otherwise`.

; Every word is a function from a stack to a new stack. `binary` turns a
; function of two integers into such a word: it takes the top two values,
; the deeper one as the left operand, and pushes the result.
(define binary
  (lambda (operation)
    (lambda (stack)
      (match stack
        (right left &rest below) (prepend (operation left right) below)
        otherwise (error "not enough values for an operator" stack)))))

(define duplicate
  (lambda (stack)
    (match stack
      (top &rest _) (prepend top stack)
      otherwise (error "nothing to duplicate"))))

(define swap
  (lambda (stack)
    (match stack
      (top next &rest below) (prepend next (prepend top below))
      otherwise (error "not enough values to swap" stack))))

; The dictionary: a map from the text of a word to its function. Adding a
; word is adding an entry; nothing else in the program changes.
(define words
  {"+" (binary +)
   "-" (binary -)
   "*" (binary *)
   "/" (binary quotient)
   "%" (binary remainder)
   "dup" duplicate
   "swap" swap})

; ---- evaluating ---------------------------------------------------------------------

; One token: a number is pushed, a known word runs, anything else is an
; error. `string-to-number` accepts "-3" as a number, so "-" alone is the
; word for subtraction.
(define step
  (lambda (stack token)
    (let ((number (string-to-number token)))
      (if (integer? number) (prepend number stack)
          (contains? words token) ((get words token) stack)
          otherwise (error "unknown word" token)))))

(define tokens
  (lambda (line)
    (filter (lambda (token) (not (empty? token)))
            (t/split " " line))))

; `fold` threads the stack through the tokens, left to right, starting
; from the empty stack. The line is valid when one value is left: the
; pattern (value) matches a list of exactly one element.
(define evaluate
  (lambda (line)
    (let ((stack (fold step () (tokens line))))
      (match stack
        (value) value
        otherwise (error "expected one value at the end, found" stack)))))

; ---- the loop -----------------------------------------------------------------------

; The message, then each of the descriptor's values as `display!` would
; print it.
(define describe
  (lambda (problem)
    (t/join " " (prepend (concatenate "error: " (get problem :message))
                         (map to-string (get problem :values))))))

(define answer
  (lambda (line)
    (catch (lambda () (to-string (evaluate line)))
           describe)))

(define answer-line
  (lambda (line)
    (concatenate line "  →  " (answer line) "\n")))

; `read-lines!` returns every line of the input, in order, as a List of
; Strings; it computes nothing from them. The work on the lines is pure and
; builds the text, and the program prints it once.

(display! (t/join "" (map answer-line (read-lines!))))
