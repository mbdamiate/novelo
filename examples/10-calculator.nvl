; A calculator in reverse Polish notation.
;
; Each input line is an expression with the operator after its operands:
; "3 4 +" is 3 + 4, and "5 1 2 + 4 * + 3 -" is 5 + (1 + 2) × 4 - 3. Numbers
; are pushed on a stack; each word takes its operands from the top of the
; stack and pushes its result. A line is valid when exactly one value is
; left. Errors are reported per line and do not stop the calculator.
;
;   build/novelo examples/10-calculator.nvl < examples/10-calculator.input
;
; It brings together the earlier examples: reading input (01), tail-call
; loops (02, 03), lists and fold (04), maps (05), errors (07).

(import io)
(import list)      ; fold, filter, map
(import text t)    ; t/split, t/join

; ---- the stack ------------------------------------------------------------------

; The stack is a plain list with its top first. It is never changed: pushing
; with `prepend` makes a new stack, and `rest` gives the stack below the top.

; Every word is a function from a stack to a new stack. `binary` turns a
; function of two integers into such a word: it takes the top two values,
; the deeper one as the left operand, and pushes the result.
(define binary
  (lambda (operation)
    (lambda (stack)
      (if (< (count stack) 2) (error "not enough values for an operator" stack)
          otherwise (let ((right (first stack))
                          (left (first (rest stack))))
                      (prepend (operation left right) (rest (rest stack))))))))

(define duplicate
  (lambda (stack)
    (if (empty? stack) (error "nothing to duplicate")
        otherwise (prepend (first stack) stack))))

(define swap
  (lambda (stack)
    (if (< (count stack) 2) (error "not enough values to swap" stack)
        otherwise (prepend (first (rest stack))
                           (prepend (first stack) (rest (rest stack)))))))

; The dictionary: a map from the text of a word to its function. Adding a
; word is adding an entry; nothing else in the program changes.
(define words
  {"+" (binary +)
   "-" (binary -)
   "*" (binary *)
   "/" (binary quotient)
   "%" (binary remainder)
   "dup" duplicate
   "swap" swap})

; ---- evaluating ---------------------------------------------------------------------

; One token: a number is pushed, a known word runs, anything else is an
; error. `string-to-number` accepts "-3" as a number, so "-" alone is the
; word for subtraction.
(define step
  (lambda (stack token)
    (let ((number (string-to-number token)))
      (if (integer? number) (prepend number stack)
          otherwise (if (contains? words token) ((get words token) stack)
                        otherwise (error "unknown word" token))))))

(define tokens
  (lambda (line)
    (filter (lambda (token) (not (empty? token)))
            (t/split " " line))))

; `fold` threads the stack through the tokens, left to right, starting
; from the empty stack.
(define evaluate
  (lambda (line)
    (let ((stack (fold step () (tokens line))))
      (if (= (count stack) 1) (first stack)
          otherwise (error "expected one value at the end, found" stack)))))

; ---- the loop -----------------------------------------------------------------------

; The message, then each of the descriptor's values as `display!` would
; print it.
(define describe
  (lambda (problem)
    (t/join " " (prepend (concatenate "error: " (get problem :message))
                         (map to-string (get problem :values))))))

(define answer
  (lambda (line)
    (catch (lambda () (to-string (evaluate line)))
           describe)))

(define calculate!
  (lambda ()
    (let ((line (read-line!)))
      (if (void? line) #void
          otherwise (sequence
                      (display! (concatenate line "  →  " (answer line) "\n"))
                      (calculate!))))))

(calculate!)
